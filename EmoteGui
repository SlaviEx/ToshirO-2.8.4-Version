-- =========================================================
--              FAVORITES HELPERS (FIFO left-to-right)
-- =========================================================

local function getFavIndex(emoteId)
	return table.find(FavoritedEmotes, emoteId)
end

local function saveFavorites()
	WriteFileFunc("FavoritedEmotes.txt", HttpService:JSONEncode(FavoritedEmotes))
	WriteFileFunc("CustomEmoteOrder.txt", HttpService:JSONEncode(FavoritedEmotes))
end

-- Refresh LayoutOrders so favorited items populate sequentially left-to-right at top
local function SortEmotes()
	local favCount = #FavoritedEmotes
	for _, Emote in pairs(Emotes) do
		local EmoteButton = Frame:FindFirstChild(tostring(Emote.id))
		if not EmoteButton then continue end
		local fi = getFavIndex(Emote.id)
		if fi then
			EmoteButton.LayoutOrder = fi + 1 -- Slot 1 reserved for HideFavorites button
		else
			EmoteButton.LayoutOrder = favCount + 1 + (Emote.sort[CurrentSort] or Emote.index or 0)
		end
		local numLabel = EmoteButton:FindFirstChild("number")
		if numLabel then numLabel.Text = tostring(Emote.sort[CurrentSort] or Emote.index or 0) end
	end
end

