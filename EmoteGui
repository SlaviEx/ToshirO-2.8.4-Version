UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if AwaitingKeybind and input.UserInputType == Enum.UserInputType.Keyboard then
		AvatarSwitchKeybind = input.KeyCode
		KeybindButton.Text = input.KeyCode.Name
		KeybindButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		AwaitingKeybind = false
		WriteFileFunc("AvatarSwitchKeybind.txt", HttpService:JSONEncode({ keybind = input.KeyCode.Name }))
		SendNotification("Keybind Set", "Avatar Switch keybind set to " .. input.KeyCode.Name)
		return
	end
	if input.KeyCode == AvatarSwitchKeybind then FireAvatarSwitch() end
	if input.KeyCode == Enum.KeyCode.Period then
		if ClassicModeEnabled then StopClassicMode() else StartClassicMode() end
	end
	-- Hold E to slow all playing animations
	if input.KeyCode == Enum.KeyCode.E then
		local char = Players.LocalPlayer.Character
		local Hum = char and (char:FindFirstChildOfClass("Humanoid") or char:FindFirstChildOfClass("AnimationController"))
		if Hum then
			for _, v in next, Hum:GetPlayingAnimationTracks() do v:AdjustSpeed(0.2) end
		end
	end
end)

