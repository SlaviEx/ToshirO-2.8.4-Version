local function RefreshRecordingList()
	for _, child in pairs(RecordingList:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end
	for i, recording in pairs(SavedRecordings) do
		local ItemFrame = Instance.new("Frame")
		ItemFrame.Size = UDim2.new(0.95, 0, 0, 30)
		ItemFrame.BackgroundTransparency = 0.5
		ItemFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		ItemFrame.BorderSizePixel = 0
		Corner:Clone().Parent = ItemFrame

		local PlayBtn = Instance.new("TextButton")
		PlayBtn.Size = UDim2.new(0.8, 0, 1, 0); PlayBtn.BackgroundTransparency = 1
		PlayBtn.Text = "  " .. recording.name; PlayBtn.TextColor3 = Color3.new(1, 1, 1)
		PlayBtn.TextScaled = true; PlayBtn.Font = Enum.Font.Gotham
		PlayBtn.TextXAlignment = Enum.TextXAlignment.Left
		PlayBtn.Parent = ItemFrame

		local NameBox = Instance.new("TextBox")
		NameBox.Size = UDim2.new(0.8, 0, 1, 0); NameBox.BackgroundTransparency = 1
		NameBox.Text = recording.name; NameBox.TextColor3 = Color3.new(1, 1, 1)
		NameBox.TextScaled = true; NameBox.Font = Enum.Font.Gotham
		NameBox.TextXAlignment = Enum.TextXAlignment.Left; NameBox.Visible = false
		NameBox.Parent = ItemFrame

		local DeleteBtn = Instance.new("TextButton")
		DeleteBtn.Size = UDim2.new(0.15, 0, 0.8, 0)
		DeleteBtn.AnchorPoint = Vector2.new(1, 0.5); DeleteBtn.Position = UDim2.new(0.98, 0, 0.5, 0)
		DeleteBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50); DeleteBtn.BackgroundTransparency = 0.3
		DeleteBtn.Text = "X"; DeleteBtn.TextColor3 = Color3.new(1, 1, 1)
		DeleteBtn.TextScaled = true; DeleteBtn.Font = Enum.Font.GothamBold
		Corner:Clone().Parent = DeleteBtn; DeleteBtn.Parent = ItemFrame

		ItemFrame.Parent = RecordingList

		DeleteBtn.MouseButton1Click:Connect(function()
			table.remove(SavedRecordings, i)
			WriteFileFunc("EmoteRecordings.txt", HttpService:JSONEncode(SavedRecordings))
			RefreshRecordingList()
		end)
		PlayBtn.MouseButton2Up:Connect(function()
			PlayBtn.Visible = false; NameBox.Visible = true; NameBox:CaptureFocus()
		end)
		NameBox.FocusLost:Connect(function()
			PlayBtn.Visible = true; NameBox.Visible = false
			if NameBox.Text ~= "" then
				SavedRecordings[i].name = NameBox.Text
				PlayBtn.Text = "  " .. NameBox.Text
				WriteFileFunc("EmoteRecordings.txt", HttpService:JSONEncode(SavedRecordings))
			end
		end)
		PlayBtn.MouseButton1Click:Connect(function()
			task.spawn(function()
				if IsRecording then return end
				SendNotification("Playback", "Playing " .. recording.name .. "...")
				local startTime = tick()
				for _, event in ipairs(recording.data) do
					local waitDuration = event.time - (tick() - startTime)
					if waitDuration > 0 then task.wait(waitDuration) end
					local char = Players.LocalPlayer.Character
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if not hum then continue end
					if event.id == "STOP" then
						if CurrentPlayingTrack then
							pcall(function() CurrentPlayingTrack:Stop() end)
							CurrentPlayingTrack = nil
						end
						continue
					end
					local track = PlayEmote(event.name, event.id)
					if track and typeof(track) == "Instance" and track:IsA("AnimationTrack") then
						CurrentPlayingTrack = track
					end
				end
				CurrentPlayingTrack = nil
			end)
		end)
	end
end

if not IsStudio then
	-- Load FavoritedEmotes from CustomEmoteOrder.txt
	if IsFileFunc("CustomEmoteOrder.txt") then
		pcall(function()
			local raw = HttpService:JSONDecode(ReadFileFunc("CustomEmoteOrder.txt"))
			if type(raw) == "table" then
				local isList = raw[1] ~= nil or #raw > 0
				if isList then
					for _, id in ipairs(raw) do
						local numId = tonumber(id)
						if numId and not table.find(FavoritedEmotes, numId) then
							table.insert(FavoritedEmotes, numId)
						end
					end
				else
					local pairs_sorted = {}
					for id, order in pairs(raw) do
						table.insert(pairs_sorted, { id = tonumber(id), order = order })
					end
					table.sort(pairs_sorted, function(a, b) return a.order < b.order end)
					for _, entry in ipairs(pairs_sorted) do
						if entry.id and not table.find(FavoritedEmotes, entry.id) then
							table.insert(FavoritedEmotes, entry.id)
						end
					end
				end
			end
		end)
	end

	-- If CustomEmoteOrder.txt was empty / missing, try FavoritedEmotes.txt
	if #FavoritedEmotes == 0 and IsFileFunc("FavoritedEmotes.txt") then
		pcall(function()
			local raw = HttpService:JSONDecode(ReadFileFunc("FavoritedEmotes.txt"))
			if type(raw) == "table" then
				for _, id in ipairs(raw) do
					local numId = tonumber(id)
					if numId and not table.find(FavoritedEmotes, numId) then
						table.insert(FavoritedEmotes, numId)
					end
				end
			end
		end)
		if #FavoritedEmotes > 0 then saveFavorites() end
	end

	-- Ensure both files exist and are up-to-date
	if #FavoritedEmotes > 0 then
		saveFavorites()
	else
		WriteFileFunc("FavoritedEmotes.txt",  HttpService:JSONEncode(FavoritedEmotes))
		WriteFileFunc("CustomEmoteOrder.txt", HttpService:JSONEncode(FavoritedEmotes))
	end

	-- Custom emotes
	if IsFileFunc("CustomEmotes.txt") then
